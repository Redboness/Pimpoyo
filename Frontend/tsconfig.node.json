{
  "compilerOptions": {
    "composite": true, // NECESARIO: Habilita la compilación de proyectos referenciados
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo", // Opcional, pero común
    "target": "ES2022", // O la versión de ECMAScript que soporte tu entorno Node
    "lib": ["ES2023"],   // O la versión de ECMAScript que soporte tu entorno Node
    "module": "ESNext",
    "moduleResolution": "bundler", // O "node"
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
    // "noEmit": false, // ELIMINADO o false. No debe ser true para proyectos "composite" referenciados.
                       // Si se elimina, el comportamiento por defecto es no emitir a menos que se especifique outDir.
  },
  "include": ["vite.config.ts"] // O cualquier otro archivo .ts de configuración de Node
}